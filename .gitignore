coverage/
BenchmarkDotNet.Artifacts/
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml
coverage.opencover.xml

# Visual Studio / Rider 本地缓存和个人配置；保留可共享的编辑器配置。
.vs/
.idea/
.settings/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.iml

# 本地环境和私有配置；示例文件可提交，不隐藏正常的应用配置。
.env
.env.*
!.env.example
!.env.*.example
appsettings.Local.json
appsettings.*.Local.json

# 运行日志、临时文件与编辑器备份。
logs/
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# 操作系统生成的文件。
.DS_Store
Thumbs.db
Desktop.ini

# packages.lock.json、Directory.Packages.props、源码、文档及共享配置应提交。
