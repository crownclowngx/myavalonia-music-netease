<UserControl x:Class="MusicNetEasePlugin.Features.Main.MainView" x:Name="MainRoot"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:MusicNetEasePlugin.Features.Main" xmlns:music="using:MusicNetEasePlugin.Features.Music"
 xmlns:ui="using:MusicNetEasePlugin.Infrastructure.Ui" xmlns:settings="using:MusicNetEasePlugin.Features.Settings" ui:ArtworkImage.Context="{Binding Artwork}"
 xmlns:conv="using:Avalonia.Data.Converters" x:DataType="vm:MainDocument"
 Background="{DynamicResource NeteaseDocumentBackgroundBrush}" Foreground="{DynamicResource NeteaseTextBrush}" FontSize="13">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceInclude Source="avares://MusicNetEasePlugin.Plugin/Styles/NeteaseThemeResources.axaml" />
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <UserControl.Styles><StyleInclude Source="avares://MusicNetEasePlugin.Plugin/Styles/NeteaseControlStyles.axaml" /></UserControl.Styles>
 <Grid RowDefinitions="Auto,Auto,*">
  <Border Classes="netease-divider" Padding="12,6">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <TextBlock Text="网易云音乐" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
     <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" IsVisible="{Binding IsSignedIn}" Background="{DynamicResource NeteasePanelBrush}" VerticalAlignment="Center">
      <Grid><TextBlock Text="云" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource NeteaseAccentBrush}" /><ui:ArtworkImage x:Name="AvatarImage" Bytes="{Binding AvatarImageBytes}" Stretch="UniformToFill" /></Grid>
     </Border>
     <TextBlock x:Name="AccountSummary" Text="{Binding AccountName}" MaxWidth="160" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsSignedIn}" VerticalAlignment="Center" ToolTip.Tip="{Binding AccountId}" />
     <Button Classes="netease-button" Classes.netease-motion="{Binding #MainRoot.Motion.IsEnabled}" x:Name="AccountMenuButton" Content="账号" AutomationProperties.Name="账号操作">
      <Button.Flyout><MenuFlyout>
       <MenuItem Header="账号与播放设置" Click="OpenSettings" />
       <MenuItem Header="恢复登录" Command="{Binding RestoreCommand}" />
       <MenuItem Header="重试保存登录信息" Command="{Binding RetrySaveCommand}" IsVisible="{Binding NeedsSaveRetry}" />
       <Separator />
       <MenuItem Header="退出 / 清除本地登录信息" Command="{Binding LogoutCommand}" />
      </MenuFlyout></Button.Flyout>
     </Button>
    </StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="1">
  <Border Padding="12,6" Background="{DynamicResource NeteasePanelBrush}" IsVisible="{Binding Music.History.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False, TargetNullValue=False}">
   <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Music.History.Message}" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Content="重试本地保存/清理" Command="{Binding Music.History.RetryCommand}" /></Grid>
  </Border>
  <Border Padding="12,6" Background="{DynamicResource NeteasePanelBrush}" IsVisible="{Binding NeedsSaveRetry}">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <TextBlock Text="{Binding SessionHint}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource NeteaseWarningBrush}" />
    <Button Grid.Column="1" Classes="netease-button" Content="重试保存" Command="{Binding RetrySaveCommand}" />
   </Grid>
  </Border>
  </StackPanel>
  <!-- 未登录只滚动登录主体；已登录的音乐区始终获得有限高度，列表与播放条分别布局。 -->
  <ScrollViewer Grid.Row="2" IsVisible="{Binding !IsSignedIn}" HorizontalScrollBarVisibility="Disabled">
   <Grid x:Name="LoginLayout" ColumnDefinitions="224,*" RowDefinitions="Auto,Auto" Margin="20,24" ColumnSpacing="24" RowSpacing="16" MaxWidth="760" HorizontalAlignment="Stretch">
    <Border x:Name="QrSurface" Width="224" Height="224" Padding="12" Background="White" CornerRadius="4" BorderBrush="{DynamicResource NeteaseBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
     <!-- 二维码与静区必须保持黑白图像；白底只限此处，不能扩展到登录面板。 -->
     <Grid><TextBlock Text="选择扫码方式" Foreground="#606060" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="QrImage" Stretch="Uniform" /></Grid>
    </Border>
    <StackPanel x:Name="LoginDetails" Grid.Column="1" Spacing="10" VerticalAlignment="Center">
     <TextBlock Text="连接音乐账号" FontSize="18" FontWeight="SemiBold" />
     <TextBlock Classes="netease-secondary" Text="{Binding QrInstruction}" TextWrapping="Wrap" />
     <ComboBox ItemsSource="{Binding LoginMethods}" SelectedIndex="{Binding LoginMethodIndex, Mode=TwoWay}" AutomationProperties.Name="扫码方式" HorizontalAlignment="Stretch" />
     <Button x:Name="LoginActionButton" Classes="netease-button primary" Content="{Binding LoginAction}" Command="{Binding LoginCommand}" HorizontalAlignment="Left" />
     <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Classes="netease-button" Content="取消" Command="{Binding CancelLoginCommand}" IsVisible="{Binding IsBusy}" />
      <Button Classes="netease-button" Content="重试恢复" Command="{Binding RestoreCommand}" />
     </StackPanel>
     <ProgressBar Height="3" IsVisible="{Binding IsBusy}">
      <ProgressBar.IsIndeterminate><MultiBinding Converter="{x:Static conv:BoolConverters.And}"><Binding Path="IsBusy" /><Binding ElementName="MainRoot" Path="Motion.IsEnabled" /></MultiBinding></ProgressBar.IsIndeterminate>
     </ProgressBar>
     <TextBlock x:Name="LoginStatus" Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
     <TextBlock Text="仍有未清除的本地登录信息，可从账号菜单重试清除。" IsVisible="{Binding NeedsCleanup}" TextWrapping="Wrap" Foreground="{DynamicResource NeteaseErrorBrush}" />
     <TextBlock Classes="netease-secondary" Text="登录信息仅保存在当前用户目录。关闭页面不会退出账号。" TextWrapping="Wrap" />
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <Border Grid.Row="2" IsVisible="{Binding IsSignedIn}"><music:MusicView x:Name="MusicContent" DataContext="{Binding Music}" /></Border>
  <Border x:Name="SettingsOverlay" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Background="{DynamicResource NeteaseDocumentBackgroundBrush}">
   <Grid RowDefinitions="Auto,*"><Button Content="‹ 返回音乐" Click="CloseSettings" HorizontalAlignment="Left" Classes="netease-button" Margin="8" /><settings:MusicSettingsView Grid.Row="1" DataContext="{Binding Settings}" /></Grid>
  </Border>
 </Grid>
</UserControl>
