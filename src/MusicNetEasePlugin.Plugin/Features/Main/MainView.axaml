<UserControl
    x:Class="MusicNetEasePlugin.Features.Main.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicNetEasePlugin.Features.Main"
    xmlns:music="using:MusicNetEasePlugin.Features.Music"
    x:DataType="vm:MainDocument">
  <ScrollViewer Background="#F5F6F8">
    <StackPanel Margin="32" Spacing="22" MaxWidth="820" HorizontalAlignment="Center">
      <StackPanel Spacing="6">
        <TextBlock Text="网易云音乐" FontSize="28" FontWeight="SemiBold" Foreground="#17202E" />
        <TextBlock Text="连接你的账号，让音乐回到日常。" Foreground="#667085" />
      </StackPanel>
      <Border Background="White" CornerRadius="16" Padding="28" BorderBrush="#E6E8EC" BorderThickness="1">
        <StackPanel Spacing="20">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="56" Height="56" CornerRadius="28" Background="#FFF0F1" ClipToBounds="True">
              <Grid>
                <TextBlock Text="云" FontSize="24" Foreground="#D92D40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="AvatarImage" Stretch="UniformToFill" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{Binding AccountName}" Foreground="#17202E" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AccountId}" Foreground="#667085" />
            </StackPanel>
          </Grid>
          <StackPanel IsVisible="{Binding !IsSignedIn}" Spacing="14" HorizontalAlignment="Center">
            <Border Width="248" Height="248" Background="White" BorderBrush="#E6E8EC" BorderThickness="1" CornerRadius="12" Padding="12">
              <Grid>
                <TextBlock Text="点击下方按钮获取二维码" Foreground="#98A2B3" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="QrImage" Stretch="Uniform" />
              </Grid>
            </Border>
            <TextBlock Text="{Binding QrInstruction}" Foreground="#667085" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Center">
              <Button Content="微信扫码登录 / 更新" Command="{Binding StartLoginCommand}" Margin="4"
                      Background="#07A35A" Foreground="White" Padding="18,10" />
              <Button Content="网易云 App 扫码" Command="{Binding StartNeteaseLoginCommand}" Margin="4" Padding="18,10" />
              <Button Content="取消" Command="{Binding CancelLoginCommand}" Margin="4" Padding="18,10" />
              <Button Content="重试恢复" Command="{Binding RestoreCommand}" Margin="4" Padding="18,10" />
            </WrapPanel>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsSignedIn}" Spacing="12">
            <TextBlock Text="账号已连接" Foreground="#067647" FontSize="18" />
            <TextBlock Text="{Binding SessionHint}" Foreground="#667085" TextWrapping="Wrap" />
            <Button IsVisible="{Binding NeedsSaveRetry}" Content="重试保存登录信息" Command="{Binding RetrySaveCommand}" />
          </StackPanel>
          <Border Background="#F8F9FB" CornerRadius="8" Padding="14">
            <StackPanel Spacing="8">
              <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
              <TextBlock Text="{Binding StatusMessage}" Foreground="#344054" TextWrapping="Wrap" />
              <TextBlock IsVisible="{Binding NeedsCleanup}" Text="仍有未清除的本地登录信息，请重试清除。" Foreground="#B42318" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Button Content="退出 / 清除本地登录信息" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
      <Border IsVisible="{Binding IsSignedIn}" Background="White" CornerRadius="16" Padding="24">
        <music:MusicView DataContext="{Binding Music}" />
      </Border>
      <TextBlock Text="登录信息仅保存在当前用户的数据目录。关闭页面不会退出已连接的账号。"
                 Foreground="#98A2B3" TextWrapping="Wrap" FontSize="12" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
