<UserControl x:Class="MusicNetEasePlugin.Features.Music.LyricsView" x:Name="LyricsRoot"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:MusicNetEasePlugin.Features.Music" x:DataType="vm:LyricsWorkspace">
 <UserControl.Styles>
  <Style Selector="TextBlock.lyric"><Setter Property="FontSize" Value="24" /><Setter Property="Foreground" Value="{DynamicResource NeteaseSecondaryTextBrush}" /></Style>
  <Style Selector="vm|LyricsView.compact TextBlock.lyric"><Setter Property="FontSize" Value="20" /></Style>
  <Style Selector="TextBlock.current"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource NeteaseTextBrush}" /></Style>
 </UserControl.Styles>
 <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8,0">
  <WrapPanel>
   <Button Content="回到当前歌词" IsVisible="{Binding !Following}" Classes="netease-button" Command="{Binding FollowCommand}" Margin="0,0,6,4" />
   <Button Content="重试歌词" IsVisible="{Binding Failed}" Classes="netease-button" Command="{Binding RetryCommand}" Margin="0,0,6,4" />
   <CheckBox Content="显示翻译" IsVisible="{Binding HasTranslation}" IsChecked="{Binding ShowTranslation, Mode=TwoWay}" Margin="6,0" /><TextBlock Text="已暂停跟随" IsVisible="{Binding !Following}" VerticalAlignment="Center" />
  </WrapPanel>
  <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  <Grid Grid.Row="2">
   <ListBox Classes="netease-results" MaxWidth="720" HorizontalAlignment="Stretch" x:Name="LyricList" ItemsSource="{Binding Lines}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoScrollToSelectedItem="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="同步歌词">
    <ListBox.ContextMenu><ContextMenu><MenuItem Header="跳到此句" Command="{Binding JumpCommand}" /><MenuItem Header="{Binding JumpReason}" IsEnabled="False" IsVisible="{Binding JumpReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" /></ContextMenu></ListBox.ContextMenu>
    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:LyricRow">
     <StackPanel Margin="4,8" Spacing="4">
      <TextBlock Classes="lyric" Classes.current="{Binding IsCurrent}" TextWrapping="Wrap">
       <Run Text="{Binding BeforeText}" /><Run Text="{Binding ActiveText}" Foreground="{DynamicResource NeteaseAccentBrush}" FontWeight="Bold" /><Run Text="{Binding AfterText}" />
      </TextBlock>
      <StackPanel IsVisible="{Binding #LyricsRoot.Model.ShowTranslation}"><TextBlock FontSize="13" Text="{Binding Translation}" IsVisible="{Binding Translation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource NeteaseSecondaryTextBrush}" /></StackPanel>
     </StackPanel>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <ScrollViewer IsVisible="{Binding PlainText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="{Binding PlainText}" TextWrapping="Wrap" /></ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="3"><TextBlock Text="{Binding JumpMessage}" TextWrapping="Wrap" IsVisible="{Binding JumpMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  <Expander Header="未匹配的翻译" IsVisible="{Binding UnmatchedTranslation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
   <ScrollViewer MaxHeight="100"><TextBlock Text="{Binding UnmatchedTranslation}" TextWrapping="Wrap" /></ScrollViewer>
  </Expander></StackPanel>
 </Grid>
</UserControl>
