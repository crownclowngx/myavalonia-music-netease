<UserControl x:Class="MusicNetEasePlugin.Features.Music.MusicView" x:Name="MusicRoot"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:MusicNetEasePlugin.Features.Music" xmlns:models="using:MusicNetEasePlugin.Application.Playback"
 xmlns:ui="using:MusicNetEasePlugin.Infrastructure.Ui" xmlns:conv="using:Avalonia.Data.Converters" xmlns:library="using:MusicNetEasePlugin.Features.Library" x:DataType="vm:MusicWorkspace"
 Background="{DynamicResource NeteaseDocumentBackgroundBrush}" Foreground="{DynamicResource NeteaseTextBrush}" FontSize="13" Classes.netease-comfortable="{Binding Preferences.ComfortableDensity}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://MusicNetEasePlugin.Plugin/Styles/NeteaseThemeResources.axaml" /></ResourceDictionary.MergedDictionaries><vm:TrackDurationConverter x:Key="TrackDuration" /></ResourceDictionary></UserControl.Resources>
 <UserControl.Styles><StyleInclude Source="avares://MusicNetEasePlugin.Plugin/Styles/NeteaseControlStyles.axaml" /></UserControl.Styles>
 <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
  <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,8,12,6" ColumnSpacing="8">
   <TextBox x:Name="SearchInput" Classes="netease-input" Text="{Binding Keyword, Mode=TwoWay}" PlaceholderText="搜索歌名或歌手 · Enter" KeyDown="SearchKeyDown" AutomationProperties.Name="搜索歌名或歌手" />
   <Button Grid.Column="1" Classes="netease-button" Content="清空" IsVisible="{Binding Keyword, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Click="ClearSearch" AutomationProperties.Name="清空搜索关键词" />
   <Button x:Name="SearchButton" Grid.Column="2" Classes="netease-button primary" Classes.netease-motion="{Binding #MusicRoot.Motion.IsEnabled}" Content="搜索" Command="{Binding SearchCommand}" />
  </Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="12,0,12,8"><StackPanel Orientation="Horizontal" Spacing="6">
   <ToggleButton Content="搜索" IsChecked="{Binding Navigation.SearchSelected, Mode=OneWay}" Command="{Binding ShowSearchCommand}" AutomationProperties.Name="搜索页面" />
   <ToggleButton Content="我的歌单" IsChecked="{Binding Navigation.LibrarySelected, Mode=OneWay}" Command="{Binding ShowLibraryCommand}" AutomationProperties.Name="我的歌单页面" />
   <ToggleButton Content="最近播放" IsChecked="{Binding Navigation.HistorySelected, Mode=OneWay}" Command="{Binding ShowHistoryCommand}" AutomationProperties.Name="最近播放页面" />
  </StackPanel>
   <Grid Grid.Column="1" IsVisible="{Binding Player.ShowRestoration}">
    <StackPanel x:Name="RestoreInline" Orientation="Horizontal" Spacing="4"><TextBlock Text="{Binding Player.RestorationText}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Content="继续播放" Classes="netease-button" Command="{Binding Player.ResumeCommand}" /><Button Content="收起" Classes="netease-button" Command="{Binding Player.DismissRestorationCommand}" /></StackPanel>
    <Button x:Name="RestoreCompact" Content="恢复提示" Classes="netease-button" AutomationProperties.Name="查看上次恢复的位置并继续播放"><Button.Flyout><Flyout><StackPanel Spacing="8" MaxWidth="300"><TextBlock Text="{Binding Player.RestorationText}" TextWrapping="Wrap" /><Button Content="继续播放" Command="{Binding Player.ResumeCommand}" /><Button Content="收起恢复提示" Command="{Binding Player.DismissRestorationCommand}" /></StackPanel></Flyout></Button.Flyout></Button>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,0,12,4" IsVisible="{Binding Library, Converter={x:Static ObjectConverters.IsNotNull}}">
   <TextBlock Text="{Binding Library.Message}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Library.Message}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
   <Button x:Name="LibraryResultsButton" Grid.Column="1" Content="操作结果" MinHeight="22" Padding="6,1" Command="{Binding Library.ResultsPanelCommand}" AutomationProperties.Name="查看音乐库操作结果与重新读取" />
  </Grid>
  <Grid x:Name="ContentStage" Grid.Row="3" Margin="12,0,12,8" ClipToBounds="True">
   <Grid x:Name="ContentLayout">
   <Grid x:Name="SearchPane" RowDefinitions="Auto,*,Auto" IsVisible="{Binding Navigation.IsSearch}">
    <Grid RowDefinitions="Auto,Auto" Margin="4,0,4,6">
     <ProgressBar Height="2" IsVisible="{Binding SearchBusy.IsVisible}"><ProgressBar.IsIndeterminate><MultiBinding Converter="{x:Static conv:BoolConverters.And}"><Binding Path="SearchBusy.IsVisible" /><Binding ElementName="MusicRoot" Path="Motion.IsEnabled" /></MultiBinding></ProgressBar.IsIndeterminate></ProgressBar>
     <TextBlock Grid.Row="1" Classes="netease-secondary" Text="{Binding SearchMessage}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SearchMessage}" AutomationProperties.LiveSetting="Polite" />
    </Grid>
    <vm:SongListBox x:Name="TrackList" Grid.Row="1" Classes="netease-results" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack, Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="歌曲搜索结果" ActivateCommand="{Binding PlayCommand}">
     <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate x:DataType="models:MusicTrack"><vm:SongRowView Title="{Binding Name}" Subtitle="{Binding Artists}" Artist="{Binding Artists}" Album="{Binding Album}" TrackId="{Binding Id}" CurrentTrackId="{Binding $parent[vm:MusicView].Model.Player.CurrentTrackId}" Duration="{Binding DurationMs, Converter={StaticResource TrackDuration}}" PlayCommand="{Binding $parent[vm:MusicView].Model.PlayCommand}" NextCommand="{Binding $parent[vm:MusicView].Model.PlayNextCommand}" AppendCommand="{Binding $parent[vm:MusicView].Model.AppendCommand}" /></DataTemplate></ListBox.ItemTemplate>
    </vm:SongListBox>
    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Spacing="8" IsVisible="{Binding ShowSearchEmpty}">
     <TextBlock Text="{Binding EmptySearchText}" TextWrapping="Wrap" TextAlignment="Center" Classes="netease-secondary" />
     <Button Classes="netease-button" Content="浏览我的歌单" Command="{Binding ShowLibraryCommand}" HorizontalAlignment="Center" />
    </StackPanel>
    <Button Grid.Row="1" Content="重试搜索" Command="{Binding RetrySearchCommand}" Classes="netease-button" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding SearchFailed}" />
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
     <TextBlock Classes="netease-secondary" Text="双击或 Enter 播放 · 右键查看更多" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Classes="netease-button" Content="上一页" Command="{Binding PreviousSearchPageCommand}" /><TextBlock Text="{Binding PageText}" Classes="netease-secondary" VerticalAlignment="Center" /><Button Classes="netease-button" Content="下一页" Command="{Binding NextSearchPageCommand}" /></StackPanel>
    </Grid>
   </Grid>
   <library:PlaylistView IsVisible="{Binding #MusicRoot.Model.Navigation.IsLibrary}" DataContext="{Binding Playlists}" />
   <vm:HistoryView IsVisible="{Binding #MusicRoot.Model.Navigation.IsHistory}" DataContext="{Binding History}" />
   </Grid>
   <Border x:Name="Drawer" IsVisible="False" HorizontalAlignment="Right" Background="{DynamicResource NeteasePanelBrush}" BorderBrush="{DynamicResource NeteaseBorderBrush}" BorderThickness="1,0,0,0">
    <Grid ColumnDefinitions="8,*">
     <Border x:Name="DrawerResize" Cursor="SizeWestEast" Focusable="True" Background="{DynamicResource NeteaseBorderBrush}" AutomationProperties.Name="调整抽屉宽度，左右键调整，Home 恢复默认" />
     <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="8,4">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6"><TextBlock Text="{Binding Navigation.PanelTitle}" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="netease-button" Content="默认宽度" Click="ResetDrawerWidth" /><Button x:Name="CloseDrawerButton" Grid.Column="2" Classes="netease-button" Content="收起 ›" Command="{Binding Navigation.BackCommand}" AutomationProperties.Name="收起侧边抽屉" /></Grid>
      <Grid Grid.Row="1" IsVisible="{Binding Navigation.IsLyrics}" RowDefinitions="Auto,*">
       <StackPanel Margin="8,2,8,4"><TextBlock Text="{Binding Player.TrackName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Player.CurrentTrack}" FontWeight="SemiBold" /><TextBlock Text="{Binding Player.Artists}" TextTrimming="CharacterEllipsis" Classes="netease-secondary" /></StackPanel>
       <vm:LyricsView Grid.Row="1" DataContext="{Binding Lyrics}" />
      </Grid>
      <Grid x:Name="QueuePanel" Grid.Row="1" IsVisible="{Binding Navigation.IsQueue}"><vm:QueueView DataContext="{Binding Queue}" /></Grid>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <vm:PlaybackBarView x:Name="PlayerBar" Grid.Row="4" />
  <library:LibraryEditorView x:Name="LibraryEditorPanel" Grid.RowSpan="5" ZIndex="20" DataContext="{Binding Library}" IsVisible="{Binding #MusicRoot.Model.Library.IsOpen, FallbackValue=False, TargetNullValue=False}" />
 </Grid>
</UserControl>
