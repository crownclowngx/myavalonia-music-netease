<UserControl x:Class="MusicNetEasePlugin.Features.Music.QueueView" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MusicNetEasePlugin.Features.Music" x:DataType="vm:QueueWorkspace">
 <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="4" RowSpacing="6">
  <Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{Binding CountText}" Classes="netease-secondary" VerticalAlignment="Center" />
   <Button Grid.Column="1" Classes="netease-button" Content="定位" Click="LocateCurrent" AutomationProperties.Name="定位当前曲目" />
   <Button Grid.Column="2" Classes="netease-button icon" AutomationProperties.Name="更多队列操作"><PathIcon Width="16" Height="16" Data="{DynamicResource NeteaseMoreIcon}" /><Button.Flyout><MenuFlyout><MenuItem Header="清空队列" Command="{Binding RequestClearCommand}" /></MenuFlyout></Button.Flyout></Button>
  </Grid>
  <TextBlock Grid.Row="1" Text="{Binding OrderHint}" Classes="netease-secondary" FontSize="11" TextWrapping="Wrap" />
  <Grid Grid.Row="2">
   <vm:SongListBox x:Name="QueueList" Classes="netease-results" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" ActivateCommand="{Binding PlayCommand}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="当前播放队列">
    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:QueueRow"><Grid ColumnDefinitions="24,*"><Button Name="QueueDragHandle" Width="24" Padding="0" Content="⠿" Cursor="SizeAll" ToolTip.Tip="拖动排序，或在歌曲菜单使用上移/下移" AutomationProperties.Name="拖动调整顺序，键盘可使用歌曲菜单上移下移" /><vm:SongRowView Grid.Column="1" TrackId="{Binding Entry.TrackId}" Title="{Binding Title}" Subtitle="{Binding Detail}" Artist="{Binding Entry.Track.Artists}" Album="{Binding Entry.Track.Album}" Current="{Binding IsCurrent}" PlayCommand="{Binding $parent[vm:QueueView].Model.PlayCommand}" RemoveCommand="{Binding $parent[vm:QueueView].Model.RemoveCommand}" UpCommand="{Binding $parent[vm:QueueView].Model.UpCommand}" DownCommand="{Binding $parent[vm:QueueView].Model.DownCommand}" /></Grid></DataTemplate></ListBox.ItemTemplate>
   </vm:SongListBox>
   <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Spacing="8"><TextBlock Text="队列还是空的，可从歌曲菜单加入。" TextWrapping="Wrap" /><Button Content="去搜索歌曲" Classes="netease-button" Click="BrowseSearch" HorizontalAlignment="Center" /></StackPanel>
   <Border x:Name="DropIndicator" Height="2" VerticalAlignment="Top" Background="{DynamicResource NeteaseAccentBrush}" IsVisible="False" IsHitTestVisible="False" />
  </Grid>
  <Border Grid.Row="3" Padding="8" Background="{DynamicResource NeteaseSelectionBrush}" IsVisible="{Binding ConfirmClear}"><StackPanel Spacing="6"><TextBlock Text="{Binding ClearText}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="确认清空" Command="{Binding ConfirmClearCommand}" Classes="netease-button primary" /><Button Content="取消" Command="{Binding CancelClearCommand}" Classes="netease-button" /></StackPanel></StackPanel></Border>
  <Grid Grid.Row="4" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" Classes="netease-secondary" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /><Button x:Name="UndoQueueButton" Grid.Column="1" Classes="netease-button" Content="{Binding UndoText}" Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}" /></Grid>
 </Grid>
</UserControl>
