<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 自有资源只合并到插件 View；继承所在窗口的主题，不修改 Host 的任何资源。 -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="NeteaseDocumentBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NeteaseToolBackgroundBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="NeteasePanelBrush" Color="#F3F4F6" />
      <SolidColorBrush x:Key="NeteaseTextBrush" Color="#202020" />
      <SolidColorBrush x:Key="NeteaseSecondaryTextBrush" Color="#666666" />
      <SolidColorBrush x:Key="NeteaseAccentBrush" Color="#C92B42" />
      <SolidColorBrush x:Key="NeteaseBorderBrush" Color="#D5D7DA" />
      <SolidColorBrush x:Key="NeteaseHoverBrush" Color="#EBEDF0" />
      <SolidColorBrush x:Key="NeteaseSelectionBrush" Color="#DCEBFA" />
      <SolidColorBrush x:Key="NeteaseSelectionTextBrush" Color="#17202E" />
      <SolidColorBrush x:Key="NeteaseSuccessBrush" Color="#067647" />
      <SolidColorBrush x:Key="NeteaseWarningBrush" Color="#8A5200" />
      <SolidColorBrush x:Key="NeteaseErrorBrush" Color="#B42318" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="NeteaseDocumentBackgroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="NeteaseToolBackgroundBrush" Color="#252525" />
      <SolidColorBrush x:Key="NeteasePanelBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="NeteaseTextBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="NeteaseSecondaryTextBrush" Color="#B8B8B8" />
      <SolidColorBrush x:Key="NeteaseAccentBrush" Color="#FF7185" />
      <SolidColorBrush x:Key="NeteaseBorderBrush" Color="#454545" />
      <SolidColorBrush x:Key="NeteaseHoverBrush" Color="#333333" />
      <SolidColorBrush x:Key="NeteaseSelectionBrush" Color="#264F78" />
      <SolidColorBrush x:Key="NeteaseSelectionTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NeteaseSuccessBrush" Color="#75D69C" />
      <SolidColorBrush x:Key="NeteaseWarningBrush" Color="#FFB74D" />
      <SolidColorBrush x:Key="NeteaseErrorBrush" Color="#FF8A80" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
