<Window
    x:Class="MusicNetEasePlugin.Standalone.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MusicNetEasePlugin.Features.Main"
    xmlns:settings="using:MusicNetEasePlugin.Features.Settings"
    Width="1180"
    Height="740"
    MinWidth="280"
    MinHeight="240"
    Title="网易云音乐 · 独立预览">
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="8" Orientation="Horizontal">
      <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeChanged" Margin="0,0,8,0" AutomationProperties.Name="预览主题">
        <ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" />
      </ComboBox>
      <ComboBox x:Name="PreviewSelector" SelectedIndex="0" SelectionChanged="PreviewChanged" AutomationProperties.Name="预览尺寸">
        <ComboBoxItem Content="并排工作区" /><ComboBoxItem Content="窄 Document" /><ComboBoxItem Content="窄 Tool" /><ComboBoxItem Content="底部 Tool" />
      </ComboBox>
    </WrapPanel>
    <Grid x:Name="PreviewLayout" ColumnDefinitions="*,320">
      <views:MainView x:Name="DocumentView" />
      <settings:MusicSettingsView Grid.Column="1" x:Name="SettingsView" />
    </Grid>
  </DockPanel>
</Window>
