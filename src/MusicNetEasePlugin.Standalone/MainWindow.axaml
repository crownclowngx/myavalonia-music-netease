<Window
    x:Class="MusicNetEasePlugin.Standalone.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MusicNetEasePlugin.Features.Main"
    xmlns:settings="using:MusicNetEasePlugin.Features.Settings"
    Width="900"
    Height="820"
    MinWidth="540"
    MinHeight="500"
    Title="网易云音乐 · 独立预览">
  <TabControl>
    <TabItem Header="音乐与登录"><views:MainView /></TabItem>
    <TabItem Header="账号与播放设置"><settings:MusicSettingsView x:Name="SettingsView" /></TabItem>
  </TabControl>
</Window>
