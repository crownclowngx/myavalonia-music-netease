<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:semi="https://irihi.tech/semi" xmlns:ursa="clr-namespace:Ursa.Themes.Semi;assembly=Ursa.Themes.Semi"
 x:Class="MusicNetEasePlugin.Tests.HostThemeProbeApp">
 <!-- 复现 Host 基础控件主题的装配顺序；不引用 Host 内部工程，也不冒充真实 Dock 测试。 -->
 <Application.Styles><FluentTheme /><semi:SemiTheme Locale="zh-CN" /><ursa:UrsaSemiTheme Locale="zh-CN" /></Application.Styles>
</Application>
